<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.eip</groupId>
    <artifactId>engineering-intelligence-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Engineering Intelligence Platform</name>
    <description>Microservice-based platform for incident analysis and engineering knowledge management</description>

    <properties>
        <java.version>17</java.version>
        <eip.version>1.0.0-SNAPSHOT</eip.version>
    </properties>

    <modules>
        <module>eip-common</module>
        <module>knowledge-store-service</module>
        <module>canonical-transformer-service</module>
        <module>similarity-service</module>
        <module>incident-analysis-service</module>
        <module>incident-ingestion-service</module>
        <module>api-gateway</module>
        <module>failure-simulator-service</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.eip</groupId>
                <artifactId>eip-common</artifactId>
                <version>${eip.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
